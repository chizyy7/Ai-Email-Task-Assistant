              "type": "string"
            },
            {
              "id": "6",
              "name": "notificationSummary",
              "value": "={{ JSON.parse($json.content.parts[0].text).summary }}",
              "type": "string"
            },
            {
              "id": "7",
              "name": "notificationMessage",
              "value": "={{ \n`<ol>\n<li><strong>Task:</strong> ${$json.notificationTask}</li>\n<li><strong>Deadline:</strong> ${$json.notificationDeadline || \"No deadline specified\"}</li>\n<li><strong>Priority:</strong> ${$json.notificationPriority}</li>\n<li><strong>Sender:</strong> ${$json.notificationSender}</li>\n<li><strong>Summary:</strong> ${$json.notificationSummary}</li>\n</ol>`\n}}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
